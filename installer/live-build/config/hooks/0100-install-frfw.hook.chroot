#!/bin/sh
# Runs inside the live-build chroot, after packages and includes.chroot
# are in place. Installs frfw itself (bundled source, staged into
# /opt/frfw-src by installer/build-live-image.sh before `lb build`
# runs -- see that script), stages the systemd units and scripts, and
# enables what the image starts on its first real boot: fr-first-boot
# (which enables everything else, see scripts/fr-first-boot.sh),
# fr-persistence-setup, fr-firewall (the fail-closed baseline) and
# fr-kernel-confirm (a staged kernel's trial boot, ROADMAP SEC-14).
set -e

echo "frfw: installing from bundled source (/opt/frfw-src)..."
# Review FR-001: dependencies only from the hash-pinned lock (wheels
# only), then frfw itself with the locked build backend and no further
# resolving -- the same two steps the updater runs (frfw.update).
pip3 install --break-system-packages --no-cache-dir --require-hashes --only-binary=:all: \
    -r /opt/frfw-src/requirements.lock
pip3 install --break-system-packages --no-cache-dir --no-deps --no-build-isolation /opt/frfw-src

# The WireGuard module is loaded at boot (security-lessons G8), so the
# sandboxed units that apply the config (ProtectKernelModules=yes) never
# have to load it themselves.
echo wireguard > /etc/modules-load.d/fr_os-wireguard.conf

# The journal's size and age limit, and the kernel's log backend for the
# ruleset's drop log (security-lessons K6).
echo nf_log_syslog > /etc/modules-load.d/fr_os-logging.conf
install -D -m 0644 /opt/frfw-src/systemd/journald-fr_os.conf /etc/systemd/journald.conf.d/fr_os.conf

# The hardware watchdog, when the machine has one: a hang -- a staged
# kernel's trial boot included -- resets the machine (ROADMAP SEC-14).
install -D -m 0644 /opt/frfw-src/systemd/watchdog-fr_os.conf /etc/systemd/system.conf.d/fr_os-watchdog.conf

# Loopback only: FR_OS owns the network ports (frfw.ifaddr gives the LAN
# its address), and fr-first-boot adds a DHCP client for the WAN port
# alone. live-boot keeps this file because of `ip=frommedia` (auto/config).
cat > /etc/network/interfaces <<'CONF'
# FR_OS: frfw configures the network ports itself; the only DHCP client
# is the WAN port's, in /etc/network/interfaces.d/fr_os-wan (fr-first-boot).
auto lo
iface lo inet loopback

source /etc/network/interfaces.d/*
CONF

echo "frfw: staging scripts and systemd units..."
install -m 0755 /opt/frfw-src/scripts/fr-first-boot.sh /usr/local/sbin/fr-first-boot.sh
install -m 0755 /opt/frfw-src/scripts/install-system-integration.sh /usr/local/sbin/install-system-integration.sh

for unit in \
    fr-first-boot.service \
    fr-persistence-setup.service \
    fr-kernel-confirm.service \
    fr-kernel-prepare.service \
    fr-kernel-prepare.timer \
    fr-accounts.service \
    fr-firewall.service \
    fr-apply-helper.socket \
    fr-apply-helper.service \
    fr-webui.service \
    fr-initial-password.path \
    fr-initial-password.service \
    fr-ai-ids.service \
    fr-iot-scan.service \
    fr-iot-scan.timer \
    fr-update-helper.socket \
    fr-update-helper.service \
    fr-xdp-sni-logger.service \
    fr-adblock-dns.service \
    fr-adblock-refresh.service \
    fr-adblock-refresh.timer \
    fr-dns-log-trim.service \
    fr-dns-log-trim.timer \
    fr-appid.service \
    fr-schedule-check.service \
    fr-schedule-check.timer \
    fr-update-check.service \
    fr-update-check.timer \
    fr-tls-fp.service
do
    install -m 0644 "/opt/frfw-src/systemd/$unit" "/etc/systemd/system/$unit"
done

install -d -m 0755 /opt/fr_os/releases

systemctl enable fr-first-boot.service
systemctl enable fr-persistence-setup.service
# Every boot FR_OS's GRUB starts: keeps a staged kernel only when the
# router came up on it (ROADMAP SEC-14). Does nothing on the image's own
# kernel but note a fallback.
systemctl enable fr-kernel-confirm.service
# From the very first boot: until fr-first-boot has written a config this
# loads the fail-closed baseline, so the WAN (DHCP'd by live-boot) is
# never up unfiltered.
systemctl enable fr-firewall.service
# ROADMAP SEC-18: Debian's own nftables.service loads /etc/nftables.conf,
# which starts with `flush ruleset`, and its stop action flushes the
# ruleset too: enabled by anyone, it would replace or wipe the FR_OS
# ruleset, and both units start before network-pre.target. FR_OS loads
# the ruleset itself (fr-firewall), so mask the unit -- it can't be
# started, enabled or pulled in. The package stays: it provides `nft`.
systemctl mask nftables.service

# ROADMAP P4-1: the XDP SNI filter's program, compiled by the image build
# (installer/build-live-image.sh) -- the image has no compiler, so
# frfw.xdp loads exactly this file (frfw.paths.XDP_BPF_OBJ_PATH). An
# update replaces it with the release's own (frfw.update).
install -D -m 0644 /opt/frfw-src/bpf/xdp_sni_filter.o /usr/local/share/fr_os/bpf/xdp_sni_filter.o

echo "frfw: removing bundled source (already installed via pip)..."
rm -rf /opt/frfw-src
