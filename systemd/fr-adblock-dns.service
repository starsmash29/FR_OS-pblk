[Unit]
Description=FR_OS ad-block DNS resolver (dedicated dnsmasq instance, see frfw.adblock.dns_service)
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=network.target fr-accounts.service
# Group=fr_os-webui below needs the group to exist.
Wants=fr-accounts.service
ConditionPathExists=/etc/fr_os/dnsmasq_adblock.conf

[Service]
Type=simple
# Starts as root to bind :53 -- dnsmasq drops to user=nobody/group=nogroup
# itself immediately after binding (its own config, generated by
# frfw.adblock.dns_service.render_dnsmasq_config), the same standard
# dnsmasq privilege-drop the stock Debian dnsmasq.service relies on.
# This is a dedicated instance, never the system's own dnsmasq.service --
# see frfw.paths.ADBLOCK_DNSMASQ_CONF_PATH's docstring for why.
# The query log (adblocker.query_logging) goes to a file of its own for
# fr-ai-ids and fr-appid, not to the journal (ROADMAP SEC-4): dnsmasq
# opens /var/log/fr_os-dns/queries.log as root under this group, then
# hands it to its own user, so it is nobody:fr_os-webui 0640 in a
# root:fr_os-webui 0750 directory -- the readers' group reads it, only
# dnsmasq writes it. fr-dns-log-trim.timer caps its size.
Group=fr_os-webui
LogsDirectory=fr_os-dns
LogsDirectoryMode=0750
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/fr_os/dnsmasq_adblock.conf
Restart=on-failure
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
# dnsmasq binds :53 on the DHCP zones' interfaces only (interface= +
# bind-interfaces, frfw.adblock.dns_service), then drops to nobody itself.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
