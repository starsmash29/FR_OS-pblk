[Unit]
Description=FR_OS ad-block DNS resolver (dedicated dnsmasq instance, see frfw.adblock.dns_service)
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=network.target
ConditionPathExists=/etc/fr_os/dnsmasq_adblock.conf

[Service]
Type=simple
# Starts as root to bind :53 -- dnsmasq drops to user=nobody/group=nogroup
# itself immediately after binding (its own config, generated by
# frfw.adblock.dns_service.render_dnsmasq_config), the same standard
# dnsmasq privilege-drop the stock Debian dnsmasq.service relies on.
# This is a dedicated instance, never the system's own dnsmasq.service --
# see frfw.paths.ADBLOCK_DNSMASQ_CONF_PATH's docstring for why.
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/fr_os/dnsmasq_adblock.conf
Restart=on-failure

[Install]
WantedBy=multi-user.target
