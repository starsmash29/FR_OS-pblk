[Unit]
Description=FR_OS: watch the webUI accounts to take the initial password off the console
Documentation=https://github.com/starsmash29/FR_OS-pblk

[Path]
# Any account change (the admin sets their own password, a
# set-admin-password run) re-checks whether the generated password still
# works; once it doesn't, it is removed from /etc/issue.d.
PathChanged=/etc/fr_os/webui/auth.json
Unit=fr-initial-password.service

[Install]
WantedBy=paths.target
