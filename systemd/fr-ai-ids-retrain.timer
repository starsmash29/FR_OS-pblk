[Unit]
Description=Daily FR_OS AI IDS retrain (mock engine)
Documentation=https://github.com/starsmash29/FR_OS-pblk

[Timer]
# Matches AiIdsConfig.retrain_time's default (03:30). If an admin sets a
# different ai_ids.retrain_time in config.yaml, this static timer does
# NOT follow it yet -- keeping the OnCalendar= in sync with the config
# would need a privileged rewrite (a systemd drop-in), which is out of
# scope while the engine itself is still a mock. Tracked as a follow-up.
OnCalendar=*-*-* 03:30:00
Persistent=true

[Install]
WantedBy=timers.target
