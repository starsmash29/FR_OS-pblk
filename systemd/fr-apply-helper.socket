[Unit]
Description=FR_OS privileged apply-helper socket

[Socket]
ExecStartPre=/bin/mkdir -p /run/fr_os
ListenStream=/run/fr_os/apply.sock
# fr_os-webui and fr_os-sensor (a member of that group) can connect;
# frfw.helper.server then allows each only its own commands, by the
# peer uid the kernel reports (frfw.helper.peer).
SocketMode=0660
SocketUser=root
SocketGroup=fr_os-webui
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
