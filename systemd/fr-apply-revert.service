[Unit]
Description=FR_OS: go back from an apply that is not confirmed in time (ROADMAP SEC-26)
Documentation=https://github.com/starsmash29/FR_OS-pblk
# Started (restarted) by the apply-helper when an Apply from the webUI is
# held for confirmation; waits for its deadline and reverts it unless it
# is confirmed first (frfw.apply_confirm). Not enabled: a boot that finds
# an apply still pending reverts it itself (fr-firewall.service).
After=fr-firewall.service
ConditionPathExists=/etc/fr_os/config.yaml

[Service]
Type=simple
ExecStart=firewall-cli apply-revert --wait /etc/fr_os/config.yaml
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
# Root, because a revert is an apply: nft, ip, Kea's and sshd's config,
# XDP pins -- the same sandbox as the apply-helper's. /var/log/fr_os for
# the revert's security alert.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/fr_os -/etc/kea -/etc/ssh/sshd_config.d -/usr/local/share/fr_os -/sys/fs/bpf -/var/log/fr_os
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
SystemCallFilter=~@clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_IPC_LOCK CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL
