[Unit]
Description=FR_OS XDP SNI filter event logger (phase 4, see frfw.xdp)
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=fr-accounts.service fr-firewall.service
Wants=fr-accounts.service fr-firewall.service

[Service]
Type=simple
# The event file the webUI, fr-ai-ids and fr-appid read instead of this
# unit's journal (ROADMAP SEC-4): /var/log/fr_os-sni, root:fr_os-feeds
# 0750, the file in it 0640. Created while the process is still root, so
# only this process can write it -- not fr_os-sensor, which it becomes
# and the readers run as; Group= is what gives both the readers' group.
Group=fr_os-feeds
LogsDirectory=fr_os-sni
LogsDirectoryMode=0750
UMask=0027
ExecStart=fr-xdp-sni-logger
Restart=on-failure
RestartSec=5
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
# Root only long enough to open a pinned BPF map: nothing but CAP_BPF and
# what switching to fr_os-sensor takes (frfw.privdrop). /sys stays writable
# (no ProtectKernelTunables): the pinned maps live on bpffs under it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service bpf
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_BPF CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
