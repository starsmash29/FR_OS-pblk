[Unit]
Description=FR_OS first-boot setup (interface assignment, admin password, service enablement)
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=network-pre.target fr-persistence-setup.service
ConditionPathExists=!/etc/fr_os/.first-boot-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=fr-first-boot.sh
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
# One-time machine setup: writes /etc (config, accounts, interfaces),
# takes the LAN port's DHCP client down and starts every FR_OS unit --
# too broad for a strict sandbox; what it never needs is shut.
NoNewPrivileges=yes
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
