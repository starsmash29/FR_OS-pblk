[Unit]
Description=FR_OS persistence setup (keep the live system's state across reboots)
Documentation=https://github.com/starsmash29/FR_OS-pblk
# Only on the live image booted with the "persistence" option; the
# command itself does nothing when persistence is already in use. It
# runs before fr-first-boot so that, when it creates the persistence
# partition and reboots, first-boot's password and settings are made on
# the persistent system, not in RAM.
ConditionKernelCommandLine=boot=live
ConditionKernelCommandLine=persistence
Before=fr-first-boot.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=firewall-cli persistence auto --reboot
StandardOutput=journal+console
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
# Partitions the boot medium and formats the persistence partition: it
# needs the raw block devices and mount, so only what it never needs is shut.
NoNewPrivileges=yes
ProtectHome=read-only
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
