[Unit]
Description=FR_OS application identification daemon (phase 16, see frfw.appid)
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=fr-accounts.service network.target
Wants=fr-accounts.service

[Service]
Type=simple
# Parses untrusted network input, so it runs as fr_os-sensor, not as the
# webUI: it can read config.yaml (group fr_os-webui), may send the
# apply-helper only frfw.helper.peer.SENSOR_COMMANDS, and writes to
# /etc/fr_os/sensors -- never to the webUI's own state (see frfw.accounts).
User=fr_os-sensor
Group=fr_os-sensor
# Read-only journal access to follow fr-adblock-dns.service's query log
# and fr-xdp-sni-logger.service's SNI events -- the same minimal
# privilege fr-ai-ids.service uses. This daemon never talks to the
# apply-helper and never changes any enforcement state: it only writes
# its display-only usage summary under /etc/fr_os/sensors. While
# app_control is off it idles, re-reading config.yaml periodically.
# systemd-journal only for the resolver's query log (fr-adblock-dns's
# journal, adblocker.query_logging): the XDP SNI events come from the
# logger's event file, readable through fr_os-webui (ROADMAP SEC-4).
SupplementaryGroups=fr_os-webui systemd-journal
ExecStart=fr-appid
Restart=on-failure
RestartSec=5
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/fr_os/sensors
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
