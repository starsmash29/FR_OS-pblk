[Unit]
Description=FR_OS application identification daemon (phase 16, see frfw.appid)
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=fr-accounts.service network.target fr-firewall.service
Wants=fr-accounts.service

[Service]
Type=simple
# Parses untrusted network input, so it runs as fr_os-sensor, not as the
# webUI: it reads the configuration without its secrets
# (/etc/fr_os/sensor-config.yaml) and can't read config.yaml -- it is in
# no group of the webUI's but fr_os-feeds (ROADMAP SEC-11) -- may send the
# apply-helper only frfw.helper.peer.SENSOR_COMMANDS, and writes to
# /etc/fr_os/sensors -- never to the webUI's own state (see frfw.accounts).
User=fr_os-sensor
Group=fr_os-sensor
# Read-only journal access to follow fr-adblock-dns.service's query log
# and fr-xdp-sni-logger.service's SNI events -- the same minimal
# privilege fr-ai-ids.service uses. This daemon never talks to the
# apply-helper and never changes any enforcement state: it only writes
# its display-only usage summary under /etc/fr_os/sensors. While
# app_control is off it idles, re-reading its configuration periodically.
# No journal access (ROADMAP SEC-4, review v0.2.0 R10): the XDP SNI
# events and the resolver's query log come from their writers' own
# files, readable through the fr_os-feeds group.
SupplementaryGroups=fr_os-feeds
ExecStart=fr-appid
Restart=on-failure
RestartSec=5
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/fr_os/sensors
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
