[Unit]
Description=FR_OS scheduled-rule DST check (phase 17, see frfw.schedule_refresh)
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=fr-firewall.service
ConditionPathExists=/etc/fr_os/config.yaml

[Service]
Type=oneshot
# Root, like fr-firewall.service: when the UTC offset changed it re-runs
# the same `apply` that service runs at boot. It never applies a config
# that differs from the last applied one (see frfw.schedule_refresh).
ExecStart=firewall-cli schedule-check /etc/fr_os/config.yaml
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
# Root, because this is what changes the network: nft, ip, Kea's and
# sshd's config, XDP pins. Everything else is shut: only the paths an
# apply writes, no kernel modules/logs/clock, no namespaces, a reduced
# capability set. /sys stays writable for the XDP pins on bpffs.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/fr_os -/etc/kea -/etc/ssh/sshd_config.d -/usr/local/share/fr_os -/sys/fs/bpf
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
SystemCallFilter=~@clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_IPC_LOCK CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL
