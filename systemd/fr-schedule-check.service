[Unit]
Description=FR_OS scheduled-rule DST check (phase 17, see frfw.schedule_refresh)
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=fr-firewall.service
ConditionPathExists=/etc/fr_os/config.yaml

[Service]
Type=oneshot
# Root, like fr-firewall.service: when the UTC offset changed it re-runs
# the same `apply` that service runs at boot. It never applies a config
# that differs from the last applied one (see frfw.schedule_refresh).
ProtectSystem=full
ProtectHome=true
# An apply also writes Kea's config (frfw.kea), and, when enabled, the
# sshd PQC drop-in (frfw.pqc) and the compiled XDP object (frfw.xdp);
# "-" = fine if that directory doesn't exist. Without /etc/kea here
# the very first apply on a booted image failed (read-only /etc).
ReadWritePaths=/etc/fr_os /etc/kea -/etc/ssh/sshd_config.d -/usr/local/share/fr_os
ExecStart=firewall-cli schedule-check /etc/fr_os/config.yaml
