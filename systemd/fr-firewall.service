[Unit]
Description=FR_OS firewall ruleset (frfw)
Documentation=https://github.com/starsmash29/FR_OS-pblk
Wants=network-pre.target
Before=network-pre.target shutdown.target
# Debian's nftables.service is masked in the image (ROADMAP SEC-18): it
# would load /etc/nftables.conf (`flush ruleset`). Ordered after it all
# the same, so even an unmasked one can't load its file over this ruleset.
After=nftables.service
Conflicts=shutdown.target
DefaultDependencies=no
# No ConditionPathExists=/etc/fr_os/config.yaml: without a config (or when
# the apply fails with nothing loaded) --fail-closed loads a baseline that
# drops everything inbound but loopback and replies, and all forwarding.

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=null
ExecStart=firewall-cli apply --fail-closed /etc/fr_os/config.yaml
ExecReload=firewall-cli apply --fail-closed /etc/fr_os/config.yaml
# No ExecStop: stopping or restarting the unit (an update restarts it)
# keeps the ruleset loaded. To really open the box: `nft flush ruleset`.
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
# Root, because this is what changes the network: nft, ip, Kea's and
# sshd's config, XDP pins. Everything else is shut: only the paths an
# apply writes, no kernel modules/logs/clock, no namespaces, a reduced
# capability set. /sys stays writable for the XDP pins on bpffs;
# /var/log/fr_os for the audit log's security alert when config.yaml
# fails at boot and the router falls back (ROADMAP SEC-5).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/fr_os -/etc/kea -/etc/ssh/sshd_config.d -/usr/local/share/fr_os -/sys/fs/bpf -/var/log/fr_os
ProtectHome=yes
# No PrivateTmp here (it would order this early unit after the /tmp and
# /var/tmp mounts), and /tmp is read-only under ProtectSystem=strict: an
# apply writes its temporary files (the Kea config check) here instead.
RuntimeDirectory=fr-firewall
Environment=TMPDIR=/run/fr-firewall
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
SystemCallFilter=~@clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_IPC_LOCK CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL

[Install]
WantedBy=sysinit.target
