[Unit]
Description=FR_OS webUI
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=fr-accounts.service fr-apply-helper.socket network.target
# fr-initial-password: takes the generated password off the console once
# it has been changed (also on a box updated from a version that wrote
# it to /etc/issue).
Wants=fr-accounts.service fr-apply-helper.socket fr-initial-password.path fr-initial-password.service

[Service]
Type=simple
User=fr_os-webui
Group=fr_os-webui
# No journal access (ROADMAP SEC-4, review v0.2.0 R10): the XDP screen's
# live log follows fr-xdp-sni-logger's event file, readable by this
# unit's own group (frfw.paths.SNI_EVENTS_PATH), and the dashboard's
# recent drops come from the kernel log through the apply-helper.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Points OpenSSL at the TLS group preference frfw.pqc regenerates on
# every `apply` (see that module's docstring for why this -- rather
# than anything settable on ssl.SSLContext -- is the only mechanism
# that actually configures a TLS 1.3 hybrid PQC group list). Always
# set, whether or not PQC is enabled in config: the referenced file
# always exists and is always a valid OpenSSL config (classical-only
# groups when disabled), so this line is harmless either way, and only
# ever affects this one process, never anything else on the host.
Environment=OPENSSL_CONF=/etc/fr_os/webui_pqc_openssl.cnf
ExecStart=fr-webui
Restart=on-failure
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/fr_os/webui
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
