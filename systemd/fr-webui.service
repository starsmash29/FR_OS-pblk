[Unit]
Description=FR_OS webUI
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=fr-apply-helper.socket network.target
Wants=fr-apply-helper.socket

[Service]
Type=simple
User=fr_os-webui
Group=fr_os-webui
# Read-only journal access for the XDP SNI filter screen's live log
# stream (frfw.webui.routes.xdp tails `journalctl -u
# fr-xdp-sni-logger.service -f`) -- the standard, minimal-privilege way
# for a non-root process to read journald without needing root or a
# broader capability. It grants nothing beyond "read the journal";
# fr-xdp-sni-logger.service itself still runs as root, since the pinned
# BPF map it reads is root-only (see that unit's own comment).
SupplementaryGroups=systemd-journal
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Points OpenSSL at the TLS group preference frfw.pqc regenerates on
# every `apply` (see that module's docstring for why this -- rather
# than anything settable on ssl.SSLContext -- is the only mechanism
# that actually configures a TLS 1.3 hybrid PQC group list). Always
# set, whether or not PQC is enabled in config: the referenced file
# always exists and is always a valid OpenSSL config (classical-only
# groups when disabled), so this line is harmless either way, and only
# ever affects this one process, never anything else on the host.
Environment=OPENSSL_CONF=/etc/fr_os/webui_pqc_openssl.cnf
ExecStart=fr-webui
Restart=on-failure
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/fr_os/webui

[Install]
WantedBy=multi-user.target
