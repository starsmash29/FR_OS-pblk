[Unit]
Description=FR_OS IoT device discovery and isolation scan (phase 14, see frfw.iot)
Documentation=https://github.com/starsmash29/FR_OS-pblk
After=fr-accounts.service fr-apply-helper.socket network.target
Wants=fr-accounts.service fr-apply-helper.socket

[Service]
Type=oneshot
# Unprivileged on purpose: this is the process that parses untrusted
# network input (mDNS responses, client-supplied DHCP hostnames). The two
# privileged steps -- reading Kea's lease file and replacing the kernel
# iot_isolated set -- go through fr-apply-helper's Unix socket, the same
# split fr-ai-ids.service uses. Exits immediately if iot.enabled is false.
# Parses untrusted network input, so it runs as fr_os-sensor, not as the
# webUI: it can read config.yaml (group fr_os-webui), may send the
# apply-helper only frfw.helper.peer.SENSOR_COMMANDS, and writes to
# /etc/fr_os/sensors -- never to the webUI's own state (see frfw.accounts).
User=fr_os-sensor
Group=fr_os-sensor
SupplementaryGroups=fr_os-webui
ExecStart=fr-iot-scan
# Sandbox (security-lessons I1; checked by tests/test_systemd_sandbox.py).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/fr_os/sensors
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
