[Unit]
Description=FR_OS: remove the initial admin password from the console once changed (frfw.initial_password)
Documentation=https://github.com/starsmash29/FR_OS-pblk

[Service]
Type=oneshot
ExecStart=firewall-cli initial-password
ProtectSystem=full
ProtectHome=true
ReadWritePaths=-/etc/issue.d -/etc/issue
