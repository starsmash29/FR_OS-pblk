{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "A Prometheus data source scraping this FR_OS router's GET /metrics endpoint (see ARCHITECTURE.md's phase 12 section).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "FR_OS Router",
  "description": "Software and hardware telemetry scraped from an FR_OS router's GET /metrics endpoint (frfw.metrics, phase 12); with several routers, pick one with the Site selector (phase 20). Every query below references a metric name that endpoint actually emits -- see docs/CONFIG_SCHEMA.md and ARCHITECTURE.md for what each one measures.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["fr_os", "firewall", "router"],
  "uid": "fr-os-router",
  "templating": { "list": [
    {"name": "site", "label": "Site", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(fros_info, site)", "refId": "site"}, "definition": "label_values(fros_info, site)", "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}, "sort": 1}
  ] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "XDP fast path",
      "description": "0 = disabled, 1 = native driver mode, 2 = generic (SKB) mode -- see fros_xdp_status in frfw.metrics.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_xdp_status{site=~\"$site\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "Disabled", "color": "red" },
              "1": { "text": "Native", "color": "green" },
              "2": { "text": "Generic", "color": "yellow" }
            } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ad-block domains",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_adblock_total_domains{site=~\"$site\"}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ZTNA active sessions",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_ztna_active_sessions{site=~\"$site\"}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Brute-force banned IPs",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red", "value": 5 }
        ] } },
        "overrides": []
      },
      "targets": [
        { "expr": "fros_bruteforce_banned_ips{site=~\"$site\"}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "AI IDS quarantined hosts",
      "description": "Hosts currently in the kernel's ids_quarantine nftables set (phase 11).",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red", "value": 3 }
        ] } },
        "overrides": []
      },
      "targets": [
        { "expr": "fros_ai_ids_quarantined_hosts{site=~\"$site\"}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "XDP-blocked connections (total)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_xdp_blocked_connections_total{site=~\"$site\"}", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Network",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Interface throughput",
      "description": "irate() of fros_interface_bytes_total{device, direction} -- per-NIC, per-direction bytes/sec.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "irate(fros_interface_bytes_total{site=~\"$site\"}[5m])",
          "legendFormat": "{{device}} {{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "XDP SNI-blocklist drops/sec",
      "description": "irate() of fros_xdp_blocked_connections_total -- a rising rate here is also what feeds phase 11's AI IDS scoring.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "irate(fros_xdp_blocked_connections_total{site=~\"$site\"}[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Hardware",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "gauge",
      "title": "CPU usage",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {
        "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.7 },
          { "color": "red", "value": 0.9 }
        ] }
      }, "overrides": [] },
      "targets": [
        { "expr": "fros_hw_cpu_usage_ratio{site=~\"$site\"}", "refId": "A" }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "CPU clock",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "rotmhz" }, "overrides": [] },
      "targets": [
        { "expr": "fros_hw_cpu_mhz{site=~\"$site\"}", "refId": "A" }
      ]
    },
    {
      "id": 23,
      "type": "gauge",
      "title": "RAM usage",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {
        "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.8 },
          { "color": "red", "value": 0.95 }
        ] }
      }, "overrides": [] },
      "targets": [
        {
          "expr": "fros_hw_ram_usage_bytes{site=~\"$site\"} / fros_hw_ram_total_bytes{site=~\"$site\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "RAM installed",
      "description": "One series per populated memory slot (fros_hw_ram_info{model, speed_mhz}), summed here for a total.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [
        { "expr": "fros_hw_ram_total_bytes{site=~\"$site\"}", "refId": "A" }
      ]
    },
    {
      "id": 25,
      "type": "bargauge",
      "title": "Storage usage by mount",
      "description": "fros_hw_storage_usage_bytes / fros_hw_storage_total_bytes per real block-device mount (fros_hw_storage_info{mount, device_name}).",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {
        "unit": "percentunit", "min": 0, "max": 1
      }, "overrides": [] },
      "targets": [
        {
          "expr": "fros_hw_storage_usage_bytes{site=~\"$site\"} / fros_hw_storage_total_bytes{site=~\"$site\"}",
          "legendFormat": "{{mount}} ({{device_name}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "IoT",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "bargauge",
      "title": "Devices by classification",
      "description": "fros_iot_devices{category} from the last IoT scan (phase 14).",
      "gridPos": { "h": 6, "w": 16, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_iot_devices{site=~\"$site\"}", "legendFormat": "{{category}}", "refId": "A" }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "IoT devices isolated",
      "description": "MACs currently in the kernel iot_isolated set (phase 14).",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_iot_isolated_devices{site=~\"$site\"}", "refId": "A" }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "DNS filtering",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "bargauge",
      "title": "Blocked domains by category",
      "description": "fros_dns_blocked_domains{category} -- domains loaded into the resolver per blocklist category (phase 15).",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_dns_blocked_domains{site=~\"$site\"}", "legendFormat": "{{category}}", "refId": "A" }
      ]
    },
    {
      "id": 50,
      "type": "row",
      "title": "Applications",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 51,
      "type": "bargauge",
      "title": "Active clients per app (15 min)",
      "description": "fros_app_active_clients{app, category} from fr-appid (phase 16).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "topk(10, fros_app_active_clients{site=~\"$site\"})", "legendFormat": "{{app}}", "refId": "A" }
      ]
    },
    {
      "id": 52,
      "type": "bargauge",
      "title": "App hits (24 h)",
      "description": "fros_app_hits_24h{app, category} -- DNS lookups and TLS connections attributed to each app (phase 16).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "topk(10, fros_app_hits_24h{site=~\"$site\"})", "legendFormat": "{{app}}", "refId": "A" }
      ]
    },
    {
      "id": 60,
      "type": "row",
      "title": "TLS fingerprints",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 51 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 61,
      "type": "stat",
      "title": "Distinct JA4 fingerprints",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "fros_tls_distinct_fingerprints{site=~\"$site\"}", "refId": "A" } ]
    },
    {
      "id": 62,
      "type": "stat",
      "title": "Fingerprinted devices",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "fros_tls_fingerprinted_clients{site=~\"$site\"}", "refId": "A" } ]
    },
    {
      "id": 63,
      "type": "bargauge",
      "title": "Fingerprint events (24 h)",
      "description": "fros_tls_fingerprint_events_24h{type}: new fingerprints and blocklist matches (phase 19).",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "fros_tls_fingerprint_events_24h{site=~\"$site\"}", "legendFormat": "{{type}}", "refId": "A" } ]
    }
  ]
}
