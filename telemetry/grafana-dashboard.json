{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "A Prometheus data source scraping this FR_OS router's GET /metrics endpoint (see ARCHITECTURE.md's phase 12 section).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "FR_OS Router",
  "description": "Software and hardware telemetry scraped from a single FR_OS router's GET /metrics endpoint (frfw.metrics, phase 12). Every query below references a metric name that endpoint actually emits -- see docs/CONFIG_SCHEMA.md and ARCHITECTURE.md for what each one measures.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["fr_os", "firewall", "router"],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "XDP fast path",
      "description": "0 = disabled, 1 = native driver mode, 2 = generic (SKB) mode -- see fros_xdp_status in frfw.metrics.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_xdp_status", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "Disabled", "color": "red" },
              "1": { "text": "Native", "color": "green" },
              "2": { "text": "Generic", "color": "yellow" }
            } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ad-block domains",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_adblock_total_domains", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ZTNA active sessions",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_ztna_active_sessions", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Brute-force banned IPs",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red", "value": 5 }
        ] } },
        "overrides": []
      },
      "targets": [
        { "expr": "fros_bruteforce_banned_ips", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "AI IDS quarantined hosts",
      "description": "Hosts currently in the kernel's ids_quarantine nftables set (phase 11).",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red", "value": 3 }
        ] } },
        "overrides": []
      },
      "targets": [
        { "expr": "fros_ai_ids_quarantined_hosts", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "XDP-blocked connections (total)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "fros_xdp_blocked_connections_total", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Network",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Interface throughput",
      "description": "irate() of fros_interface_bytes_total{device, direction} -- per-NIC, per-direction bytes/sec.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "irate(fros_interface_bytes_total[5m])",
          "legendFormat": "{{device}} {{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "XDP SNI-blocklist drops/sec",
      "description": "irate() of fros_xdp_blocked_connections_total -- a rising rate here is also what feeds phase 11's AI IDS scoring.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "irate(fros_xdp_blocked_connections_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Hardware",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "gauge",
      "title": "CPU usage",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {
        "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.7 },
          { "color": "red", "value": 0.9 }
        ] }
      }, "overrides": [] },
      "targets": [
        { "expr": "fros_hw_cpu_usage_ratio", "refId": "A" }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "CPU clock",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "rotmhz" }, "overrides": [] },
      "targets": [
        { "expr": "fros_hw_cpu_mhz", "refId": "A" }
      ]
    },
    {
      "id": 23,
      "type": "gauge",
      "title": "RAM usage",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {
        "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.8 },
          { "color": "red", "value": 0.95 }
        ] }
      }, "overrides": [] },
      "targets": [
        {
          "expr": "fros_hw_ram_usage_bytes / fros_hw_ram_total_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "RAM installed",
      "description": "One series per populated memory slot (fros_hw_ram_info{model, speed_mhz}), summed here for a total.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [
        { "expr": "fros_hw_ram_total_bytes", "refId": "A" }
      ]
    },
    {
      "id": 25,
      "type": "bargauge",
      "title": "Storage usage by mount",
      "description": "fros_hw_storage_usage_bytes / fros_hw_storage_total_bytes per real block-device mount (fros_hw_storage_info{mount, device_name}).",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {
        "unit": "percentunit", "min": 0, "max": 1
      }, "overrides": [] },
      "targets": [
        {
          "expr": "fros_hw_storage_usage_bytes / fros_hw_storage_total_bytes",
          "legendFormat": "{{mount}} ({{device_name}})",
          "refId": "A"
        }
      ]
    }
  ]
}
