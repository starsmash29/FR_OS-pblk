{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "A Prometheus server scraping several FR_OS routers, each as a job named fr_os-<site> with a `site` target label (telemetry/prometheus-multisite.yml).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "FR_OS Fleet",
  "uid": "fr-os-fleet",
  "description": "Read-only overview of several FR_OS routers (phase 20). Every query was evaluated against a real Prometheus scraping two routers -- see tests/test_multisite_prometheus.py.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "fr_os",
    "fleet"
  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(up{job=~\"fr_os.*\"}, site)",
          "refId": "site"
        },
        "definition": "label_values(up{job=~\"fr_os.*\"}, site)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Fleet",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": [],
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Sites reporting",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(up{job=~\"fr_os.*\", site=~\"$site\"} == 1) or vector(0)",
          "refId": "A"
        }
      ],
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Sites down",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(up{job=~\"fr_os.*\", site=~\"$site\"} == 0) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Configs failing validation",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(fros_config_valid{site=~\"$site\"} == 0) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Quarantined hosts (all sites)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(fros_ai_ids_quarantined_hosts{site=~\"$site\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Banned login sources (all sites)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(fros_bruteforce_banned_ips{site=~\"$site\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Blocklisted TLS fingerprints (24 h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(fros_tls_fingerprint_events_24h{site=~\"$site\", type=\"blocklist\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "table",
      "title": "Sites",
      "description": "One row per router. Click a site to open its detailed dashboard.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "max by (site) (up{job=~\"fr_os.*\", site=~\"$site\"})",
          "refId": "UP",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "max by (site, hostname, version, codename) (fros_info{site=~\"$site\"})",
          "refId": "INFO",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "max by (site) (fros_config_valid{site=~\"$site\"})",
          "refId": "CFG",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "max by (site) (fros_hw_cpu_usage_ratio{site=~\"$site\"})",
          "refId": "CPU",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "max by (site) (fros_hw_ram_usage_bytes{site=~\"$site\"} / fros_hw_ram_total_bytes{site=~\"$site\"})",
          "refId": "RAM",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sum by (site) (irate(fros_interface_bytes_total{site=~\"$site\"}[5m]))",
          "refId": "BPS",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "max by (site) (fros_xdp_status{site=~\"$site\"})",
          "refId": "XDP",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "max by (site) (fros_ai_ids_quarantined_hosts{site=~\"$site\"})",
          "refId": "QUAR",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #INFO": true
            },
            "renameByName": {
              "Value #UP": "Up",
              "Value #CFG": "Config valid",
              "Value #CPU": "CPU",
              "Value #RAM": "RAM",
              "Value #BPS": "Throughput",
              "Value #XDP": "XDP mode",
              "Value #QUAR": "Quarantined"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "site"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__data.fields.site}",
                    "url": "/d/fr-os-router?var-site=${__data.fields.site}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Throughput"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "row",
      "title": "Trends",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": [],
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput per site",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (site, direction) (irate(fros_interface_bytes_total{site=~\"$site\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{site}} {{direction}}"
        }
      ],
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "timeseries",
      "title": "CPU per site",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (site) (fros_hw_cpu_usage_ratio{site=~\"$site\"})",
          "refId": "A",
          "legendFormat": "{{site}}"
        }
      ],
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "timeseries",
      "title": "Security enforcement per site",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (site) (fros_ai_ids_quarantined_hosts{site=~\"$site\"})",
          "refId": "A",
          "legendFormat": "{{site}} quarantined"
        },
        {
          "expr": "sum by (site) (fros_bruteforce_banned_ips{site=~\"$site\"})",
          "refId": "B",
          "legendFormat": "{{site}} banned"
        },
        {
          "expr": "sum by (site) (increase(fros_xdp_blocked_connections_total{site=~\"$site\"}[1h]))",
          "refId": "C",
          "legendFormat": "{{site}} XDP drops/h"
        }
      ],
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "bargauge",
      "title": "Apps with most active clients (all sites)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "topk(10, sum by (app) (fros_app_active_clients{site=~\"$site\"}))",
          "refId": "A",
          "legendFormat": "{{app}}",
          "instant": true
        }
      ],
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    }
  ]
}
