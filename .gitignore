# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors
.vscode/
.idea/
*.swp

# Local runtime artifacts (generated configs, not source)
*.nft.generated
/state/
/*.db

# live-build outputs (regenerated by installer/build-live-image.sh,
# never source -- includes a full rsynced copy of the repo under
# config/includes.chroot/opt/frfw-src plus the built chroot/ISO)
installer/live-build/.build/
installer/live-build/cache/
installer/live-build/chroot/
installer/live-build/binary*/
installer/live-build/*.iso
installer/live-build/*.img
installer/live-build/*.zsync
installer/live-build/*.log
installer/live-build/*.files
installer/live-build/*.packages
installer/live-build/config/includes.chroot/opt/frfw-src/

# lb_config's own generated state (a full dump of every live-build(7)
# variable, derived entirely from auto/config -- not authored, and
# regenerated by every `lb config` run in build-live-image.sh)
installer/live-build/.lock
installer/live-build/config/binary
installer/live-build/config/bootstrap
installer/live-build/config/chroot
installer/live-build/config/common
installer/live-build/config/source
installer/live-build/chroot.headers
installer/live-build/chroot.packages.install
installer/live-build/chroot.packages.live
installer/live-build/binary.packages
